# ─── LLM 백엔드 설정 ────────────────────────────────────────────────────────────

# 로컬 LLM 서버 주소 (mlx_lm / llama.cpp / vLLM 등)
LLM_BASE_URL=http://localhost:8080

# 외부 API 사용 시 (예: Groq)
# LLM_BASE_URL=https://api.groq.com/openai

# 사용할 모델명
LLM_DEFAULT_MODEL=gemma4:e4b

# 외부 API 키 (로컬 LLM 서버 사용 시 불필요)
# LLM_API_KEY=your_api_key_here

# 요청 타임아웃 (초)
LLM_REQUEST_TIMEOUT=120

# ─── API 서버 설정 ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8002
APP_LOG_LEVEL=info
